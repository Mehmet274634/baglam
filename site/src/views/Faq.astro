---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Cta from "../components/Cta.astro";
import { t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).faq;
---

<Base lang={lang} page="faq" title={p.title} description={p.description}>
  <PageHero eyebrow={p.eyebrow} title={p.h1} dim={p.h1dim} />
  <section class="wrap" style="padding-bottom:clamp(72px,11vw,140px)">
    <div class="faq">
      {p.items.map((x, i) => (
        <details open={i === 0}>
          <summary>{x.q}</summary>
          <div class="answer"><p>{x.a}</p></div>
        </details>
      ))}
    </div>
  </section>
  <Cta lang={lang} />
</Base>
