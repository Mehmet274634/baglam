---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Constellation from "../components/Constellation.astro";
import Cta from "../components/Cta.astro";
import Art from "../components/illustrations/Art.astro";
import { t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).ecosystem;
const wireArt = ["stack", "approve", "handoff", "spark"] as const;
---

<Base lang={lang} page="ecosystem" title={p.title} description={p.description}>
  <PageHero fx="rays" eyebrow={p.eyebrow} title={p.h1} dim={p.h1dim} lead={p.lead} />

  <section class="wrap constellation-sec">
    <div class="rise"><Constellation size="lg" label={p.h1 + " " + p.h1dim} /></div>
  </section>

  <section class="section band">
    <div class="wrap">
      <SectionHead title={p.wiresTitle} />
      <div class="grid-4">
        {p.wires.map((w, i) => (
          <article class="card reveal">
            <div class="art small-art"><Art name={wireArt[i]} /></div>
            <h3 class="h3">{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <SectionHead title={p.pairsTitle} dim={p.pairsDim} />
    <div class="pairs">
      {p.pairs.map((x) => (
        <article class="card reveal pair">
          <div class="route">
            <span class="chip-tool">{x.from}</span>
            <span class="line" aria-hidden="true"><i></i></span>
            <span class="chip-tool to">{x.to}</span>
          </div>
          <p>{x.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section band">
    <div class="wrap hub">
      <h2 class="h2 reveal">{p.hubTitle}</h2>
      <p class="lead reveal">{p.hubText}</p>
    </div>
  </section>

  <Cta lang={lang} />
</Base>

<style>
  .constellation-sec {
    padding-bottom: clamp(56px, 8vw, 110px);
  }
  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .grid-4 > * {
    min-width: 0;
  }
  .small-art {
    height: 120px !important;
  }
  .pairs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .pairs > * {
    min-width: 0;
  }
  .route {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .chip-tool {
    font-size: 13.5px;
    font-weight: 560;
    padding: 7px 12px;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    background: rgb(255 255 255 / 3%);
    white-space: nowrap;
  }
  .chip-tool.to {
    border-color: rgb(63 208 201 / 45%);
    color: #9be7e3;
  }
  .line {
    position: relative;
    flex: 1;
    height: 1px;
    min-width: 40px;
    background: linear-gradient(90deg, rgb(149 143 255 / 50%), rgb(63 208 201 / 50%));
    overflow: visible;
  }
  .line i {
    position: absolute;
    top: -2px;
    left: 0;
    width: 28px;
    height: 5px;
    border-radius: 3px;
    background: linear-gradient(90deg, transparent, #fff, transparent);
    filter: drop-shadow(0 0 6px #7c74ff);
    animation: run 2.4s cubic-bezier(0.5, 0, 0.3, 1) infinite;
  }
  @keyframes run {
    from {
      left: 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    to {
      left: calc(100% - 28px);
      opacity: 0;
    }
  }
  .hub {
    display: grid;
    gap: 22px;
    justify-items: center;
    text-align: center;
  }
  .hub .lead {
    max-width: 52rem;
  }
  @media (max-width: 960px) {
    .grid-4 {
      grid-template-columns: 1fr 1fr;
    }
    .pairs {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .grid-4 {
      grid-template-columns: 1fr;
    }
    .chip-tool {
      font-size: 12px;
      padding: 6px 9px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line i {
      animation: none;
      display: none;
    }
  }
</style>
