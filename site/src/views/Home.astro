---
import Base from "../layouts/Base.astro";
import Brief from "../components/Brief.astro";
import Marquee from "../components/Marquee.astro";
import SectionHead from "../components/SectionHead.astro";
import Terminal from "../components/Terminal.astro";
import PanelStage3D from "../components/PanelStage3D.astro";
import Constellation from "../components/Constellation.astro";
import HeroBeams from "../components/HeroBeams.astro";
import Cta from "../components/Cta.astro";
import Art from "../components/illustrations/Art.astro";
import { siApple, siLinux } from "simple-icons";
import { href, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const flowArt = ["search", "approve", "stack"] as const;
const secArts = ["local", "shield", "approve", "panel"] as const;
const faq = d.faq.items.slice(0, 4);
---

<Base lang={lang} page="" title={h.title} description={h.description}>
  <!-- Opening: full screen, centred, rays of light behind. On phones the logo strip joins it so the
       first screen is exactly one screen. -->
  <div class="first">
  <section class="hero">
    <HeroBeams />
    <div class="wrap hero-inner">
      <h1 class="display hero-title">{h.h1}</h1>
      <p class="lead two-tone hero-lead">{h.lead1} <span class="dim">{h.lead2}</span></p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={href(lang, "get-started")}>{h.primary} <span class="arrow">→</span></a>
        <a class="btn btn-ghost btn-lg" href={href(lang, "how-it-works")}>{h.secondary}</a>
      </div>
    </div>
    <a class="scroll-cue" href="#works" aria-label={d.common.worksWith}><span></span></a>
  </section>

  <div id="works"><Marquee lang={lang} /></div>
  </div>

  <!-- 01 The problem, and the one memory in the middle -->
  <section class="section wrap problem">
    <p class="statement reveal">{h.statement1} <span class="dim">{h.statement2}</span></p>
    <div class="rise constellation-wrap">
      <Constellation label={h.connectTitle + " " + h.connectDim} />
    </div>
    <h2 class="h2 two-tone center-t reveal">{h.connectTitle} <span class="dim">{h.connectDim}</span></h2>
    <a class="btn btn-ghost reveal" href={href(lang, "ecosystem")}>{d.nav.ecosystem} <span class="arrow">→</span></a>
  </section>

  <!-- 02 How it works -->
  <section class="section band">
    <div class="wrap">
      <SectionHead title={h.howTitle} dim={h.howDim} />
      <div class="grid-3">
        {d.how.flow.map((f, i) => (
          <article class="card reveal">
            <div class="art"><Art name={flowArt[i]} /></div>
            <span class="step-no mono">0{i + 1}</span>
            <h3 class="h3">{f.t}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 Handoff -->
  <section class="section wrap">
    <div class="split">
      <div class="reveal copy-col">
        <h2 class="h2 two-tone">{h.handoffTitle} <span class="dim">{h.handoffDim}</span></h2>
        <p class="lead">{h.handoffText}</p>
        <a class="btn btn-ghost" style="width:fit-content" href={href(lang, "handoff")}>{h.handoffLink} <span class="arrow">→</span></a>
      </div>
      <div class="stage rise">
        <div class="stack">
          <Brief lang={lang} asked />
          <Terminal
            lang={lang}
            title="codex"
            lines={[
              { cmd: lang === "en" ? "codex \"keep going\"" : "codex \"devam et\"" },
              { out: lang === "en" ? "→ context_brief: Continue from here" : "→ context_brief: Buradan devam et", kind: "ac" },
              { out: lang === "en" ? "✓ checkpoint saved · next: idempotency" : "✓ kaydedildi · sırada: tekrar engeli", kind: "ok" },
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Automatic saving -->
  <section class="section band">
    <div class="wrap">
      <SectionHead title={h.autoTitle} dim={h.autoDim} />
      <div class="grid-3">
        {h.autoCards.map((c, i) => (
          <article class="card reveal autocard">
            <div class:list={["mini", ["mini-asked", "mini-files", "mini-now"][i]]} aria-hidden="true">
              <span class="mini-chip">{c.chip}</span>
              {i === 0 && c.sample.map((x, k) => <span class:list={["mini-say", { latest: k === c.sample.length - 1 }]}>{x}</span>)}
              {i === 1 && <span class="mini-files-row">{c.sample.map((x) => <code class="mini-file"><i></i>{x}</code>)}</span>}
              {i === 2 && c.sample.map((x, k) => <span class:list={["mini-now-line", { next: k > 0 }]}>{k === 0 && <i class="live"></i>}{x}</span>)}
            </div>
            <h3 class="h3">{c.t}</h3>
            <p>{c.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 The panel -->
  <section class="section wrap">
    <div class="split">
      <div class="reveal copy-col">
        <h2 class="h2 two-tone">{h.tourTitle} <span class="dim">{h.tourDim}</span></h2>
        <p class="lead">{h.tourText}</p>
        <ul class="ticks">{h.tourPoints.map((x) => <li>{x}</li>)}</ul>
        <a class="btn btn-ghost" style="width:fit-content" href={href(lang, "panel")}>{d.nav.panel} <span class="arrow">→</span></a>
      </div>
      <div class="rise"><PanelStage3D lang={lang} /></div>
    </div>
  </section>

  <!-- 06 Install -->
  <section class="section band">
    <div class="wrap">
      <SectionHead title={h.installTitle} dim={h.installDim} lead={h.installText} />
      <div class="os-row">
        {[
          { n: "macOS", path: siApple.path },
          { n: "Windows" },
          { n: "Linux", path: siLinux.path },
        ].map((o) => (
          <a class="card reveal os-mini" href={href(lang, "get-started")}>
            <span class="os-ic" aria-hidden="true">
              {o.path ? (
                <svg viewBox="0 0 24 24"><path d={o.path} fill="currentColor" /></svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="16" rx="2.5" /><path d="M2.5 8.5h19" /><circle cx="5.5" cy="6.25" r=".6" fill="currentColor" /><circle cx="7.5" cy="6.25" r=".6" fill="currentColor" /></svg>
              )}
            </span>
            <span class="os-n">{o.n}</span>
            <span class="arrow muted">→</span>
          </a>
        ))}
      </div>
      <div class="reveal" style="margin-top:22px">
        <Terminal
          lang={lang}
          lines={[
            { cmd: "npm i -g baglam" },
            { cmd: "baglam setup" },
            { out: "Found: Claude Code, Codex CLI, Antigravity, Gemini CLI, Cursor, VS Code" },
            { out: "✓ Cursor auto-save       added     ~/.cursor/hooks.json", kind: "ok" },
            { cmd: "baglam init" },
            { cmd: "baglam doctor" },
            { out: "Everything looks good.", kind: "ac" },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 07 Privacy -->
  <section class="section wrap">
    <SectionHead title={h.secTitle} dim={h.secDim} />
    <div class="grid-4">
      {h.secCards.map((c, i) => (
        <article class="card reveal">
          <div class="art small-art"><Art name={secArts[i]} /></div>
          <h3 class="h3">{c.t}</h3>
          <p>{c.d}</p>
        </article>
      ))}
    </div>
    <div class="stats">
      {h.stats.map((s) => (
        <div class="stat reveal">
          <div class="num">{s.n}</div>
          <div class="muted">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section band">
    <div class="wrap split faq-split">
      <div class="reveal copy-col">
        <h2 class="h2">{h.faqTitle}</h2>
        <a class="btn btn-ghost" style="width:fit-content" href={href(lang, "faq")}>{h.faqLink} <span class="arrow">→</span></a>
      </div>
      <div class="faq reveal">
        {faq.map((x, i) => (
          <details open={i === 0}>
            <summary>{x.q}</summary>
            <div class="answer"><p>{x.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Cta lang={lang} />
</Base>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 70px);
    display: grid;
    place-items: center;
    padding: clamp(90px, 12vh, 150px) 0 110px;
    isolation: isolate;
  }
  .hero-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 26px;
  }
  .hero-inner > * {
    min-width: 0;
  }
  .hero-title {
    max-width: 13ch;
    font-size: clamp(2.8rem, 7.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    background: linear-gradient(180deg, #ffffff 35%, #a9aebb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* background-clip:text only paints inside the box, and the tight line-height puts the tails of
       g, y and p below it. Extra room at the bottom, taken back with a negative margin, keeps the
       letters whole without moving anything. */
    padding-bottom: 0.16em;
    margin-bottom: -0.11em;
    animation: enter 1.1s var(--ease) both;
  }
  .hero-lead {
    max-width: 42rem;
    animation: enter 1.1s 120ms var(--ease) both;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    animation: enter 1.1s 220ms var(--ease) both;
  }
  .btn-lg {
    height: 46px;
    padding: 0 22px;
    font-size: 15.5px;
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(8px);
    }
  }
  .scroll-cue {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    display: grid;
    justify-items: center;
    padding-top: 8px;
  }
  .scroll-cue span {
    width: 3px;
    height: 8px;
    border-radius: 2px;
    background: var(--text);
    animation: cue 1.8s ease-in-out infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    70% {
      transform: translateY(12px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
  .problem {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 28px;
  }
  .problem .statement {
    max-width: 58rem;
  }
  .constellation-wrap {
    width: 100%;
    margin: 20px 0 6px;
  }
  .center-t {
    max-width: 24ch;
  }
  .step-no {
    display: block;
    color: var(--accent-hover);
    font-size: 13px;
    margin-bottom: 8px;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .split > * {
    min-width: 0;
  }
  .faq-split {
    grid-template-columns: 1fr 1.6fr;
    align-items: start;
  }
  .copy-col {
    display: grid;
    gap: 20px;
    align-content: center;
  }
  .stack {
    display: grid;
    gap: 14px;
  }
  .ticks {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    color: var(--muted);
  }
  .ticks li::before {
    content: "✓";
    color: var(--cyan);
    margin-right: 10px;
  }
  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .grid-4 > * {
    min-width: 0;
  }
  .small-art {
    height: 120px !important;
  }
  .autocard .mini {
    height: 140px;
    margin-bottom: 20px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background:
      radial-gradient(80% 100% at 0% 0%, rgb(124 116 255 / 16%), transparent 60%),
      rgb(255 255 255 / 2%);
    padding: 18px;
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .mini-chip {
    width: fit-content;
    font: 600 11px/1 var(--mono);
    color: var(--accent-hover);
    background: var(--accent-soft);
    border: 1px solid rgb(124 116 255 / 28%);
    padding: 5px 9px;
    border-radius: 999px;
  }
  /* Each card's little window shows what is actually saved, not placeholder bars. */
  .mini {
    overflow: hidden;
  }
  .autocard .mini.mini-asked {
    gap: 8px;
  }
  .mini-asked .mini-chip {
    margin-bottom: 4px;
  }
  .mini-say {
    width: fit-content;
    max-width: 100%;
    font-size: 13px;
    line-height: 1.35;
    color: var(--muted);
    padding: 6px 11px;
    border-radius: 12px 12px 12px 4px;
    background: rgb(255 255 255 / 5%);
    border: 1px solid var(--border);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini-say.latest {
    color: var(--text);
    border-color: rgb(124 116 255 / 32%);
    background: rgb(124 116 255 / 10%);
  }
  .mini-files-row {
    display: grid;
    gap: 7px;
  }
  .mini-file {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    font: 12px/1 var(--mono);
    padding: 6px 9px;
    border-radius: 7px;
    background: rgb(255 255 255 / 4%);
    border: 1px solid var(--border);
    color: var(--warn);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini-file i {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 8px var(--ok);
  }
  .mini-now-line {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13.5px;
    font-weight: 560;
    color: var(--text);
  }
  .mini-now-line.next {
    font-weight: 400;
    color: var(--muted);
    padding-left: 16px;
  }
  .mini-now-line .live {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
  }
  .mini-files {
    background:
      radial-gradient(80% 100% at 0% 0%, rgb(240 180 76 / 10%), transparent 60%),
      rgb(255 255 255 / 2%);
  }
  .mini-files .mini-chip {
    color: var(--warn);
    background: rgb(240 180 76 / 10%);
    border-color: rgb(240 180 76 / 28%);
  }
  .mini-now {
    background:
      radial-gradient(80% 100% at 0% 0%, rgb(63 208 201 / 12%), transparent 60%),
      rgb(255 255 255 / 2%);
  }
  .mini-now .mini-chip {
    color: #6fe0da;
    background: rgb(63 208 201 / 10%);
    border-color: rgb(63 208 201 / 28%);
  }
  .os-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .os-row > * {
    min-width: 0;
  }
  .os-mini {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
  }
  .os-ic {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: radial-gradient(70% 70% at 30% 20%, rgb(255 255 255 / 10%), rgb(255 255 255 / 3%));
    border: 1px solid rgb(255 255 255 / 9%);
  }
  .os-ic svg {
    width: 24px;
    height: 24px;
  }
  .os-n {
    font-size: 17px;
    font-weight: 600;
    flex: 1;
  }
  .stats {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
  }
  .stat {
    padding: 30px 26px;
    border-right: 1px solid var(--border);
    background: linear-gradient(180deg, rgb(255 255 255 / 2.5%), transparent);
  }
  .stat:last-child {
    border-right: 0;
  }
  .stat .num {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    font-weight: 620;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
    background: linear-gradient(180deg, #fff, #9aa0ab);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (max-width: 960px) {
    .split,
    .faq-split {
      grid-template-columns: 1fr;
    }
    .grid-4,
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(2) {
      border-right: 0;
    }
    .stat:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
    .os-row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    /* The first screen: opening + logo strip fill the screen under the 70px bar, nothing more. */
    .first {
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - 70px);
    }
    .hero {
      flex: 1;
      min-height: 0;
      padding: 28px 0 12px;
    }
    .hero-inner {
      gap: 22px;
    }
    .hero-title {
      font-size: clamp(2.6rem, 12.4vw, 3.4rem);
    }
    .hero-lead {
      font-size: 16.5px;
      max-width: 22rem;
    }
    .first :global(.marquee-sec) {
      padding: 6px 0 calc(22px + env(safe-area-inset-bottom));
    }
  }
  @media (max-width: 560px) {
    .grid-4,
    .stats {
      grid-template-columns: 1fr;
    }
    .stat {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .scroll-cue {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-lead,
    .actions {
      animation: none;
    }
    .scroll-cue span {
      animation: none;
    }
  }
</style>
