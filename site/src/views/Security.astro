---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Cta from "../components/Cta.astro";
import Art from "../components/illustrations/Art.astro";
import { t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).security;
const pillarArt = ["local", "shield", "approve"] as const;
---

<Base lang={lang} page="security" title={p.title} description={p.description}>
  <PageHero fx="scan" eyebrow={p.eyebrow} title={p.h1} dim={p.h1dim} lead={p.lead} />

  <section class="section wrap" style="padding-top:0">
    <div class="grid-3">
      {p.pillars.map((x, i) => (
        <article class="card reveal">
          <div class="art"><Art name={pillarArt[i]} /></div>
          <h2 class="h3">{x.t}</h2>
          <p>{x.d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <SectionHead title={p.panelTitle} />
      <div class="bento">
        {p.panel.map((x) => (
          <article class="card wide reveal">
            <h3 class="h3">{x.t}</h3>
            <p>{x.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <SectionHead title={p.trustTitle} />
    <div class="rows">
      {p.trust.map((x) => (
        <div class="row reveal">
          <h3>{x.t}</h3>
          <p>{x.d}</p>
        </div>
      ))}
    </div>
  </section>

  <Cta lang={lang} />
</Base>
