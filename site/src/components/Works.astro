---
import { t, type Lang } from "../i18n";
interface Props { lang: Lang }
const d = t(Astro.props.lang).common;
---

<section class="section-tight wrap reveal">
  <div class="works">
    <span class="lbl">{d.worksWith}</span>
    {d.tools.map((name) => <span class="tool">{name}</span>)}
  </div>
</section>
