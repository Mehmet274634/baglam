---
import Logo from "./Logo.astro";
import { href, t, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---

<!-- The closing call to action: a lit stage with the logo, so every page ends on a strong note. -->
<section class="section wrap cta reveal">
  <div class="cta-box">
    <span class="cta-grid" aria-hidden="true"></span>
    <span class="cta-mark" aria-hidden="true"><Logo size={44} /></span>
    <h2 class="h2 two-tone">{d.cta.title} <span class="dim">{d.cta.dim}</span></h2>
    <div class="actions">
      <a class="btn btn-primary" href={href(lang, "get-started")}>{d.cta.primary} <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href={href(lang, "faq")}>{d.cta.secondary}</a>
    </div>
  </div>
</section>

<style>
  .cta-box {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 28px;
    padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 64px);
    border-radius: 28px;
    border: 1px solid var(--border);
    background:
      radial-gradient(60% 70% at 50% 0%, rgb(124 116 255 / 20%), transparent 70%),
      radial-gradient(45% 60% at 85% 100%, rgb(63 208 201 / 12%), transparent 70%),
      radial-gradient(40% 60% at 10% 100%, rgb(124 116 255 / 10%), transparent 70%),
      linear-gradient(180deg, #111215, #0b0c0e);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 7%), 0 40px 120px -60px rgb(124 116 255 / 45%);
  }
  /* A fine line grid that fades out from the centre. */
  .cta-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 5%) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center;
    -webkit-mask-image: radial-gradient(60% 70% at 50% 40%, #000, transparent 75%);
    mask-image: radial-gradient(60% 70% at 50% 40%, #000, transparent 75%);
  }
  .cta-mark {
    display: grid;
    place-items: center;
    padding: 14px;
    border-radius: 22px;
    background: radial-gradient(80% 80% at 30% 20%, rgb(40 40 60 / 90%), rgb(14 15 18 / 92%));
    border: 1px solid rgb(255 255 255 / 14%);
    box-shadow: 0 0 50px rgb(124 116 255 / 45%), 0 0 110px rgb(63 208 201 / 18%), inset 0 1px 0 rgb(255 255 255 / 10%);
  }
  .cta h2 {
    max-width: 22ch;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (max-width: 640px) {
    .cta-box {
      border-radius: 22px;
      gap: 22px;
    }
  }
</style>
