---
/**
 * Line-art head in profile whose mind is a network of memory nodes: one memory many agents share.
 * Drawn by hand for Bağlam; strokes use currentColor so it follows the theme.
 */
const nodes: [number, number, number][] = [
  [232, 236, 5], [292, 196, 4], [356, 188, 6], [418, 222, 4], [262, 300, 6], [330, 262, 7],
  [398, 290, 5], [452, 262, 3], [228, 360, 4], [296, 350, 5], [362, 336, 4], [430, 344, 3],
  [262, 418, 3], [332, 404, 4], [392, 398, 3],
];
const edges: [number, number][] = [
  [0, 1], [1, 2], [2, 3], [0, 4], [1, 5], [2, 5], [3, 6], [3, 7], [4, 5], [5, 6], [6, 7],
  [4, 8], [4, 9], [5, 9], [5, 10], [6, 10], [6, 11], [8, 9], [9, 10], [10, 11], [8, 12],
  [9, 13], [10, 13], [10, 14], [12, 13], [13, 14], [7, 11],
];
const glow = new Set([2, 5, 9, 6]);
---

<svg class="head" viewBox="0 0 640 600" fill="none" aria-hidden="true">
  <defs>
    <radialGradient id="hg" cx="50%" cy="45%" r="50%">
      <stop offset="0" stop-color="#7c74ff" stop-opacity="0.35" />
      <stop offset="0.6" stop-color="#3fd0c9" stop-opacity="0.08" />
      <stop offset="1" stop-color="#3fd0c9" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="hs" x1="0" y1="0" x2="0" y2="600" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.9" />
      <stop offset="0.8" stop-color="currentColor" stop-opacity="0.35" />
      <stop offset="1" stop-color="currentColor" stop-opacity="0" />
    </linearGradient>
    <filter id="hb" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
  </defs>
  <ellipse cx="340" cy="300" rx="230" ry="210" fill="url(#hg)" />
  <!-- head outline -->
  <path
    d="M188 600 C186 540 156 500 144 440 C122 330 150 196 262 140 C356 94 470 122 512 214 C528 252 526 282 532 306 L560 356 C566 368 558 376 546 378 L534 382 C538 394 536 402 528 408 C534 416 532 426 522 430 C518 454 510 470 482 474 C454 478 430 478 414 496 L408 600"
    stroke="url(#hs)"
    stroke-width="1.4"
  />
  <!-- inner contour, like an isometric second line -->
  <path
    d="M214 600 C212 548 186 510 176 452 C158 350 182 226 278 176 C360 134 456 158 490 236"
    stroke="url(#hs)"
    stroke-width="0.8"
    stroke-dasharray="2 6"
  />
  <g stroke="currentColor" stroke-opacity="0.28" stroke-width="0.9">
    {edges.map(([a, b]) => <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} />)}
  </g>
  <g>
    {nodes.map(([x, y, r], i) =>
      glow.has(i) ? (
        <g>
          <circle cx={x} cy={y} r={r * 3} fill={i % 2 ? "#3fd0c9" : "#7c74ff"} opacity="0.55" filter="url(#hb)" />
          <circle cx={x} cy={y} r={r} fill={i % 2 ? "#3fd0c9" : "#958fff"} />
        </g>
      ) : (
        <circle cx={x} cy={y} r={r} fill="#08090a" stroke="currentColor" stroke-opacity="0.7" stroke-width="1" />
      ),
    )}
  </g>
</svg>

<style>
  .head {
    width: min(560px, 100%);
    height: auto;
    color: #c9ccd3;
  }
</style>
