---
/**
 * "Works with" strip that scrolls right to left. Brand marks come from Simple Icons (CC0), inlined at
 * build time; tools without a freely licensed mark get a neutral glyph instead of an imitation.
 * Trademarks belong to their owners; shown only to say Bağlam works with these tools.
 */
import { siClaude, siCursor, siGithubcopilot, siGooglegemini, siWindsurf } from "simple-icons";
import { t, type Lang } from "../i18n";

interface Props { lang: Lang }
const d = t(Astro.props.lang).common;

type Item = { name: string; path?: string; glyph?: "terminal" | "orbit" | "brackets" };
const items: Item[] = [
  { name: "Claude Code", path: siClaude.path },
  { name: "Codex CLI", glyph: "terminal" },
  { name: "Cursor", path: siCursor.path },
  { name: "Antigravity", glyph: "orbit" },
  { name: "Gemini CLI", path: siGooglegemini.path },
  { name: "VS Code · Copilot", path: siGithubcopilot.path },
  { name: "Windsurf", path: siWindsurf.path },
  { name: d.anyMcp, glyph: "brackets" },
];
// Two copies so the loop is seamless (the second is hidden from screen readers).
const rounds = [false, true];
---

<section class="marquee-sec" aria-label={d.worksWith}>
  <p class="lbl">{d.worksWith}</p>
  <div class="marquee">
    <div class="track">
      {rounds.map((hidden) => (
        <ul class="row" aria-hidden={hidden ? "true" : undefined}>
          {items.map((it) => (
            <li class="item">
              <span class="logo" aria-hidden="true">
                {it.path ? (
                  <svg viewBox="0 0 24 24" width="22" height="22"><path d={it.path} fill="currentColor" /></svg>
                ) : it.glyph === "terminal" ? (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="19" height="16" rx="3.5" /><path d="m7 9 3 3-3 3M12.5 15H17" /></svg>
                ) : it.glyph === "orbit" ? (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(-30 12 12)" /><circle cx="12" cy="12" r="3.2" fill="currentColor" stroke="none" /></svg>
                ) : (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4H6a2 2 0 0 0-2 2v4l-2 2 2 2v4a2 2 0 0 0 2 2h2M16 4h2a2 2 0 0 1 2 2v4l2 2-2 2v4a2 2 0 0 1-2 2h-2" /></svg>
                )}
              </span>
              <span class="name">{it.name}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-sec {
    padding: clamp(40px, 6vw, 72px) 0;
    display: grid;
    gap: 22px;
  }
  .lbl {
    margin: 0;
    text-align: center;
    font: 500 11.5px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 38s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .row {
    display: flex;
    gap: 14px;
    margin: 0;
    padding: 0 7px;
    list-style: none;
  }
  .item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 22px 14px 16px;
    border-radius: 14px;
    border: 1px solid rgb(255 255 255 / 7%);
    background: linear-gradient(180deg, rgb(255 255 255 / 3.5%), rgb(255 255 255 / 1%));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 4%);
    color: #c9ccd3;
    white-space: nowrap;
    transition: color 200ms, border-color 200ms;
  }
  .item:hover {
    color: #fff;
    border-color: rgb(255 255 255 / 16%);
  }
  .logo {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgb(255 255 255 / 5%);
    border: 1px solid rgb(255 255 255 / 7%);
  }
  .name {
    font-size: 15.5px;
    font-weight: 540;
    letter-spacing: -0.01em;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    .row {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 12px;
    }
    .row[aria-hidden="true"] {
      display: none;
    }
  }
</style>
