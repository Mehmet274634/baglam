---
/** Centred page opening: eyebrow, two-tone headline, lead, optional extras. */
interface Props { eyebrow: string; title: string; dim?: string; lead?: string }
const { eyebrow, title, dim, lead } = Astro.props;
---

<section class="page-hero wrap">
  <div class="glow" aria-hidden="true"></div>
  <div class="ph-grid" aria-hidden="true"></div>
  <span class="eyebrow"><span class="dot"></span>{eyebrow}</span>
  <h1 class="display two-tone">{title}{dim && <> <span class="dim">{dim}</span></>}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</section>

<style>
  .page-hero {
    position: relative;
    justify-items: center;
    text-align: center;
  }
  .page-hero :global(.display) {
    max-width: 18ch;
  }
  .page-hero :global(.lead) {
    margin-inline: auto;
  }
  .ph-grid {
    position: absolute;
    inset: 0 0 auto;
    height: 560px;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(55% 65% at 50% 25%, #000, transparent 75%);
    mask-image: radial-gradient(55% 65% at 50% 25%, #000, transparent 75%);
  }
</style>
