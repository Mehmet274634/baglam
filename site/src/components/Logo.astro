---
/**
 * Bağlam mark: two rings (two agents) whose overlap glows — the context they share.
 * Simple enough for a favicon, meaningful enough to explain the product.
 */
interface Props { size?: number }
const { size = 24 } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
---

<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" class="mark">
  <defs>
    <linearGradient id={id} x1="12" y1="9" x2="20" y2="23" gradientUnits="userSpaceOnUse">
      <stop stop-color="#958fff" />
      <stop offset="1" stop-color="#3fd0c9" />
    </linearGradient>
  </defs>
  <rect x="0.5" y="0.5" width="31" height="31" rx="9" fill="#111214" stroke="rgb(255 255 255 / 0.14)" />
  <circle cx="12.5" cy="16" r="7" stroke="#f7f8f8" stroke-width="1.7" />
  <circle cx="19.5" cy="16" r="7" stroke="#f7f8f8" stroke-width="1.7" />
  <path d="M16 9.94 A7 7 0 0 1 16 22.06 A7 7 0 0 1 16 9.94 Z" fill={`url(#${id})`} />
</svg>
