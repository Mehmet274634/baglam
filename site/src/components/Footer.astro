---
import Head from "./illustrations/Head.astro";
import Logo from "./Logo.astro";
import { href, REPO_URL, t, type Lang, type Page } from "../i18n";

interface Props { lang: Lang; page: Page }
const { lang, page } = Astro.props;
const d = t(lang);
const other: Lang = lang === "en" ? "tr" : "en";
---

<footer class="footer">
  <div class="visual" aria-hidden="true">
    <Head />
  </div>
  <div class="word" aria-hidden="true">BAĞLAM</div>
  <div class="wrap cols">
    <div class="about">
      <a class="brand" href={href(lang, "")}><Logo size={20} /><span>Bağlam</span></a>
      <p>{d.footer.line}</p>
    </div>
    <div>
      <h2>{d.footer.product}</h2>
      <a href={href(lang, "how-it-works")}>{d.nav.how}</a>
      <a href={href(lang, "handoff")}>{d.nav.handoff}</a>
      <a href={href(lang, "automatic-saving")}>{d.nav.auto}</a>
      <a href={href(lang, "security")}>{d.nav.security}</a>
    </div>
    <div>
      <h2>{d.footer.resources}</h2>
      <a href={href(lang, "get-started")}>{d.nav.start}</a>
      <a href={href(lang, "tools")}>{d.nav.tools}</a>
      <a href={href(lang, "pricing")}>{d.nav.pricing}</a>
      <a href={href(lang, "faq")}>{d.nav.faq}</a>
    </div>
    <div>
      <h2>{d.footer.legal}</h2>
      <a href={REPO_URL} rel="noopener">GitHub</a>
      <a href={`${REPO_URL}/blob/main/LICENSE`} rel="noopener">{d.footer.license}</a>
      <span>{d.footer.local}</span>
      <span>{d.footer.noTelemetry}</span>
      <a href={href(other, page)} hreflang={other} lang={other}>{d.nav.language}</a>
    </div>
  </div>
  <div class="wrap bottom">
    <span>© 2026 Bağlam</span>
    <span>{d.footer.rights}</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(40px, 8vw, 96px);
    border-top: 1px solid rgb(255 255 255 / 6%);
    background:
      radial-gradient(60% 50% at 50% 30%, rgb(124 116 255 / 10%), transparent 70%),
      var(--canvas);
  }
  .visual {
    display: flex;
    justify-content: center;
    margin-bottom: -24vw;
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  .word {
    position: relative;
    z-index: 2;
    font-size: clamp(5rem, 24vw, 22rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    /* Room above the cap height so the breve of Ğ is painted (background-clip:text clips to the box). */
    line-height: 1;
    padding-top: 0.12em;
    text-align: center;
    background: linear-gradient(180deg, rgb(255 255 255 / 28%) 0%, rgb(255 255 255 / 8%) 55%, rgb(255 255 255 / 0%) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
    padding-bottom: 0.06em;
  }
  .cols {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 32px;
    padding-top: 40px;
    padding-bottom: 48px;
    border-top: 1px solid rgb(255 255 255 / 6%);
  }
  .cols h2 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 14px;
  }
  .cols div {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .cols a,
  .cols span {
    font-size: 14px;
    color: var(--muted);
  }
  .cols a:hover {
    color: var(--text);
  }
  .about p {
    color: var(--muted);
    font-size: 14px;
    margin: 6px 0 0;
    max-width: 22rem;
  }
  .brand {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-weight: 600;
    color: var(--text) !important;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 18px;
    padding-bottom: 28px;
    border-top: 1px solid rgb(255 255 255 / 6%);
    font-size: 13px;
    color: var(--faint);
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
